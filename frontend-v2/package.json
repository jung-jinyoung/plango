{
  "name": "plango-v2",
  "version": "0.0.1",
  "description": "Plango v2 — 계획하고 실행하고 회고하는 개인 플랫폼",
  "productName": "Plango",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,ts,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,ts,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "dayjs": "^1.11.21",
    "pinia": "^3.0.1",
    "pretendard": "^1.3.9",
    "quasar": "^2.21.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "^3.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
